# Application
APP_ENV=dev
DEBUG=false

# Authentication
AUTH_MODE=token
# Comma-separated list of valid API tokens (generate secure random tokens)
API_TOKENS=your-secure-token-here
# JSON mapping of public_id to HMAC secret (for hmac mode)
HMAC_KEYS_JSON={}
AUTH_TS_SKEW_SECONDS=300

# Redis
REDIS_URL=redis://localhost:6379/0
STREAM_MAIN=events:main
STREAM_DLQ=events:dlq

# Worker
WORKER_CONSUMER_GROUP=af_sender
WORKER_CONSUMER_NAME=
WORKER_CONCURRENCY=10
MAX_ATTEMPTS=8
BACKOFF_BASE_SECONDS=1
BACKOFF_MAX_SECONDS=60
PENDING_CLAIM_MS=60000

# AppsFlyer
APPSFLYER_BASE_URL=https://api2.appsflyer.com
APPSFLYER_TIMEOUT_SECONDS=5
# Your AppsFlyer dev key (required for sending events)
APPSFLYER_DEV_KEY=
# Your AppsFlyer app ID (for iOS: id123456789, for Android: com.example.app)
APPSFLYER_APP_ID=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# Deduplication
DEDUP_TTL_SECONDS=604800

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
