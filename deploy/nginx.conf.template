# AppsFlyer Event Sender Service - Nginx Configuration
# Скопируйте этот файл в /etc/nginx/sites-available/appsflyer
# Замените YOUR_DOMAIN на ваш реальный домен

# Rate limiting zones
limit_req_zone $binary_remote_addr zone=api_general:10m rate=50r/s;
limit_req_zone $binary_remote_addr zone=api_strict:10m rate=10r/s;

# Upstream для API service
upstream appsflyer_api {
    server localhost:8000 max_fails=3 fail_timeout=30s;
    keepalive 32;
}

# HTTP → HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;

    # Let's Encrypt ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Redirect all HTTP to HTTPS
    location / {
        return 301 https://$server_name$request_uri;
    }
}

# HTTPS server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name YOUR_DOMAIN;

    # SSL certificates (будут созданы Certbot)
    ssl_certificate /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/YOUR_DOMAIN/chain.pem;

    # SSL protocols and ciphers (Mozilla Modern configuration)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers off;

    # SSL session optimization
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    # OCSP stapling
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 8.8.8.8 8.8.4.4 valid=300s;
    resolver_timeout 5s;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    
    # Content Security Policy (настройте под свои нужды)
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;

    # Logging
    access_log /var/log/nginx/appsflyer-access.log combined;
    error_log /var/log/nginx/appsflyer-error.log warn;

    # Client settings
    client_max_body_size 10M;
    client_body_timeout 30s;
    client_header_timeout 30s;

    # Proxy settings
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    
    # Proxy timeouts
    proxy_connect_timeout 30s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;

    # Buffering
    proxy_buffering on;
    proxy_buffer_size 4k;
    proxy_buffers 8 4k;

    # Health checks (публичные, без rate limit)
    location /health {
        proxy_pass http://appsflyer_api;
        access_log off;
    }

    # API tracking endpoints (основная функциональность)
    location /v1/track {
        # Rate limiting - общий лимит
        limit_req zone=api_general burst=20 nodelay;
        limit_req_status 429;

        # Таймауты для tracking endpoints
        proxy_connect_timeout 10s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;

        # Proxy pass
        proxy_pass http://appsflyer_api;
    }

    # Metrics endpoint (ограничить доступ!)
    location /metrics {
        # ВАРИАНТ 1: Разрешить доступ только с определённых IP
        # allow 10.0.0.0/8;          # Внутренняя сеть
        # allow 203.0.113.0/24;      # Офисная сеть
        # allow 198.51.100.42;       # Monitoring server
        # deny all;

        # ВАРИАНТ 2: HTTP Basic Auth
        # auth_basic "Metrics";
        # auth_basic_user_file /etc/nginx/.htpasswd;
        # Создать пароль: htpasswd -c /etc/nginx/.htpasswd admin

        # ВАРИАНТ 3: Полностью закрыть доступ (рекомендуется если метрики не нужны публично)
        # return 404;

        proxy_pass http://appsflyer_api;
        access_log off;
    }

    # OpenAPI docs (только для dev окружения!)
    location /docs {
        # В production закройте доступ
        # return 404;
        
        # В dev можно разрешить
        proxy_pass http://appsflyer_api;
    }

    location /openapi.json {
        # return 404;
        proxy_pass http://appsflyer_api;
    }

    # Запретить доступ к скрытым файлам
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Запретить все остальное
    location / {
        return 404;
    }
}

