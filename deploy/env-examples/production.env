# Production Environment Configuration
# AppsFlyer Event Sender Service
#
# ВАЖНО: Это шаблон для production окружения
# Скопируйте в .env и заполните реальными значениями
# НИКОГДА не коммитьте .env в Git!

# ==========================================
# Application
# ==========================================
APP_ENV=prod
DEBUG=false

# ==========================================
# Authentication
# ==========================================
# Режим аутентификации: token или hmac
AUTH_MODE=token

# API Tokens (comma-separated)
# Генерация: openssl rand -hex 32
# ОБЯЗАТЕЛЬНО замените на реальные криптостойкие токены!
API_TOKENS=REPLACE_WITH_REAL_TOKEN_1,REPLACE_WITH_REAL_TOKEN_2
# Отдельные admin токены для защищённых config endpoint-ов
ADMIN_TOKENS=REPLACE_WITH_REAL_ADMIN_TOKEN

# HMAC mode (если используется)
# JSON mapping: {"public_key_id": "secret_value"}
HMAC_KEYS_JSON={}
AUTH_TS_SKEW_SECONDS=300

# ==========================================
# Redis
# ==========================================
# Используйте внутренний контейнер или managed Redis
REDIS_URL=redis://redis:6379/0
STREAM_MAIN=events:main
STREAM_DLQ=events:dlq

# ==========================================
# Worker
# ==========================================
WORKER_CONSUMER_GROUP=af_sender
WORKER_CONSUMER_NAME=
# Concurrency зависит от нагрузки и AppsFlyer rate limits
WORKER_CONCURRENCY=10
# Retry policy
MAX_ATTEMPTS=8
BACKOFF_BASE_SECONDS=1
BACKOFF_MAX_SECONDS=60
# Reclaim pending messages после 60 секунд
PENDING_CLAIM_MS=60000

# ==========================================
# AppsFlyer
# ==========================================
APPSFLYER_BASE_URL=https://api3.appsflyer.com
APPSFLYER_TIMEOUT_SECONDS=5

# ОБЯЗАТЕЛЬНО заполните!
# Dev Key из AppsFlyer Dashboard
APPSFLYER_DEV_KEY=REPLACE_WITH_YOUR_DEV_KEY

# Default App ID (для iOS: id123456789, для Android: com.example.app)
# Может быть переопределён в запросе через параметр app_id
APPSFLYER_DEFAULT_APP_ID=REPLACE_WITH_YOUR_APP_ID
# SQLite DB путь для app_id -> dev_key mapping
APPSFLYER_DEV_KEY_DB_PATH=/data/appsflyer_dev_keys.db

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_ENABLED=true
# Requests per second limit
RATE_LIMIT_RPS=100
# Burst capacity (должен быть >= RPS)
RATE_LIMIT_BURST=200

# ==========================================
# Deduplication
# ==========================================
# TTL для dedup keys в секундах (по умолчанию 7 дней)
DEDUP_TTL_SECONDS=604800

# ==========================================
# Logging
# ==========================================
# Уровень: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Формат: json (рекомендуется для production) или console
LOG_FORMAT=json

# ==========================================
# Security Notes
# ==========================================
# 1. Генерируйте API_TOKENS криптостойкими: openssl rand -hex 32
# 2. Храните .env файл в безопасном месте (1Password, Vault)
# 3. Никогда не логируйте токены и секреты
# 4. Регулярно ротируйте токены (каждые 90 дней)
# 5. Используйте разные токены для разных клиентов/интеграций

# ==========================================
# Performance Tuning
# ==========================================
# Для высокой нагрузки (>1000 req/sec):
# - Увеличьте WORKER_CONCURRENCY до 20-50
# - Увеличьте RATE_LIMIT_RPS и RATE_LIMIT_BURST
# - Рассмотрите horizontal scaling (несколько worker реплик)
# - Используйте managed Redis с высокой доступностью

# Для низкой нагрузки (<100 req/sec):
# - WORKER_CONCURRENCY=5 достаточно
# - Redis memory можно ограничить до 128MB
