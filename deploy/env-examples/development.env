# Development Environment Configuration
# AppsFlyer Event Sender Service
#
# Локальная разработка

# ==========================================
# Application
# ==========================================
APP_ENV=dev
# Включить для доступа к /docs и /openapi.json
DEBUG=true

# ==========================================
# Authentication
# ==========================================
AUTH_MODE=token
# Простые токены для dev
API_TOKENS=dev_token_123,test_token_456
ADMIN_TOKENS=dev_admin_token_123
HMAC_KEYS_JSON={}
AUTH_TS_SKEW_SECONDS=300

# ==========================================
# Redis
# ==========================================
# Локальный Redis
REDIS_URL=redis://localhost:6379/0
STREAM_MAIN=events:main
STREAM_DLQ=events:dlq

# ==========================================
# Worker
# ==========================================
WORKER_CONSUMER_GROUP=af_sender_dev
# Низкий concurrency для dev
WORKER_CONCURRENCY=2
MAX_ATTEMPTS=3
BACKOFF_BASE_SECONDS=1
BACKOFF_MAX_SECONDS=10
PENDING_CLAIM_MS=30000

# ==========================================
# AppsFlyer
# ==========================================
APPSFLYER_BASE_URL=https://api3.appsflyer.com
APPSFLYER_TIMEOUT_SECONDS=5

# Dev credentials (замените на реальные для тестирования)
APPSFLYER_DEV_KEY=
APPSFLYER_DEFAULT_APP_ID=
APPSFLYER_DEV_KEY_DB_PATH=/data/appsflyer_dev_keys.db

# ==========================================
# Rate Limiting
# ==========================================
# Отключить или мягкие лимиты для dev
RATE_LIMIT_ENABLED=false
RATE_LIMIT_RPS=1000
RATE_LIMIT_BURST=2000

# ==========================================
# Deduplication
# ==========================================
# Короткий TTL для dev (1 час)
DEDUP_TTL_SECONDS=3600

# ==========================================
# Logging
# ==========================================
# DEBUG уровень для разработки
LOG_LEVEL=DEBUG
# Console формат удобнее для локальной разработки
LOG_FORMAT=console

# ==========================================
# Development Notes
# ==========================================
# - /docs доступны на http://localhost:8000/docs
# - Redis данные можно очищать: redis-cli FLUSHALL
# - Для тестирования используйте pytest
# - Mock AppsFlyer API при необходимости
