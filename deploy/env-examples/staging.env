# Staging Environment Configuration
# AppsFlyer Event Sender Service
#
# Staging окружение для тестирования перед production

# ==========================================
# Application
# ==========================================
APP_ENV=staging
DEBUG=false

# ==========================================
# Authentication
# ==========================================
AUTH_MODE=token
# Используйте тестовые токены, отличные от production
API_TOKENS=staging_token_1,staging_token_2
HMAC_KEYS_JSON={}
AUTH_TS_SKEW_SECONDS=300

# ==========================================
# Redis
# ==========================================
REDIS_URL=redis://redis:6379/0
STREAM_MAIN=events:main
STREAM_DLQ=events:dlq

# ==========================================
# Worker
# ==========================================
WORKER_CONSUMER_GROUP=af_sender_staging
WORKER_CONCURRENCY=5
MAX_ATTEMPTS=5
BACKOFF_BASE_SECONDS=1
BACKOFF_MAX_SECONDS=30
PENDING_CLAIM_MS=60000

# ==========================================
# AppsFlyer
# ==========================================
APPSFLYER_BASE_URL=https://api3.appsflyer.com
APPSFLYER_TIMEOUT_SECONDS=5

# Используйте тестовое AppsFlyer приложение
APPSFLYER_DEV_KEY=YOUR_TEST_DEV_KEY
APPSFLYER_DEFAULT_APP_ID=YOUR_TEST_APP_ID

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_ENABLED=true
# Более мягкие лимиты для тестирования
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# ==========================================
# Deduplication
# ==========================================
# Меньший TTL для staging (1 день)
DEDUP_TTL_SECONDS=86400

# ==========================================
# Logging
# ==========================================
# INFO уровень для диагностики
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==========================================
# Staging Notes
# ==========================================
# - Используйте отдельное AppsFlyer test app
# - Регулярно очищайте staging данные
# - Тестируйте все изменения на staging перед production
# - Используйте staging для load testing
